# ── QRShield Backend Dockerfile ──────────────────────────────────────────────
FROM python:3.11-slim

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install minimal OS runtime dependencies for OpenCV and health probes
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies with pip cache reuse
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Create unprivileged application user
RUN useradd -m -u 1000 appuser

# Copy application source modules, backend, and production model artifacts
COPY --chown=appuser:appuser src/ ./src/
COPY --chown=appuser:appuser backend/ ./backend/
COPY --chown=appuser:appuser artifacts/url_baseline_phase3/ ./artifacts/url_baseline_phase3/
COPY --chown=appuser:appuser artifacts/image_baseline_gpu/ ./artifacts/image_baseline_gpu/
COPY --chown=appuser:appuser artifacts/fusion_phase3/ ./artifacts/fusion_phase3/

# Switch to non-root user
USER appuser

EXPOSE 8000

# Container readiness and liveness probe
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health/ready || exit 1

# Start Uvicorn production server
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
