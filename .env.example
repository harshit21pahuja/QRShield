# ─────────────────────────────────────────────────────────────────────────────
# QRShield — Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# --- FastAPI Backend Settings ---
APP_NAME="QRShield API"
APP_VERSION="1.1.0"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Maximum allowed file upload size in bytes (10485760 = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Logging severity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- React Frontend Settings (Vite) ---
# API base URL called by the browser
VITE_API_BASE=http://127.0.0.1:8000
